{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requirementsId": {
      "const": "urn:agentic-delivery:requirements:authority"
    },
    "sourceRepository": {
      "const": "agentic-delivery-lab/agentic-delivery-requirements"
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "withdrawn"
      ]
    },
    "authorityDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "agentic-delivery-lab/agentic-delivery-architecture"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisionId": {
          "const": "ADR-0024"
        }
      },
      "required": [
        "repository",
        "sourceCommit",
        "path",
        "sha256",
        "decisionId"
      ]
    },
    "catalogPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^requirements/(?:factory\\.yml|products/[a-z][a-z0-9-]*\\.yml)$"
      }
    },
    "approvedRequirementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(QR|FR|PR|SH)-[0-9]{3}$"
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decisionReference": {
          "type": "string",
          "format": "uri"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "actor",
        "decisionReference",
        "approvedAt"
      ]
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "decisionReference": {
          "type": "string",
          "format": "uri"
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "actor",
        "decisionReference",
        "approvedAt"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requirementsId",
    "sourceRepository",
    "repositoryId",
    "version",
    "sourceCommit",
    "contentSha256",
    "status",
    "authorityDecision",
    "catalogPaths",
    "approvedRequirementIds"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "approvedRequirementIds": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "withdrawal"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-requirements/requirements-release.schema.json",
  "title": "Immutable requirements baseline v1"
}
